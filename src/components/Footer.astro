---
interface Props {
  lang: "ko" | "en";
  current: "home" | "about" | "leaf" | "contact";
}

const { lang, current } = Astro.props;
const isEn = lang === "en";
const prefix = isEn ? "/en" : "";
const logo = isEn ? "/assets/logo/neurinlab-logo-en.svg" : "/assets/logo/neurinlab-logo-ko.svg";
const nav = [
  { key: "home", label: "Home", href: `${prefix}/` },
  { key: "about", label: "About", href: `${prefix}/about/` },
  { key: "leaf", label: "Tools", href: `${prefix}/leaf/` },
  { key: "contact", label: "Contact Us", href: `${prefix}/contact/` }
];
const note = isEn
  ? "Slow questions become practical tools."
  : "느린 질문에서 시작해, 실제 도구로 이어집니다.";
---

<footer class="site-footer">
  <div class="footer-inner">
    <a class="footer-logo" href={prefix || "/"} aria-label={isEn ? "Neurinlab home" : "느린랩 홈"}>
      <img src={logo} alt={isEn ? "Neurinlab" : "느린랩"} />
    </a>
    <div class="footer-row">
      <p class="footer-note">{note}</p>
      <nav aria-label={isEn ? "Footer navigation" : "하단 메뉴"}>
        <ul class="footer-nav">
          {nav.map((item) => (
            <li>
              <a class="footer-link" href={item.href} aria-current={current === item.key ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>
