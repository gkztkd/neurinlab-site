---
interface Props {
  lang: "ko" | "en";
  current: "home" | "about" | "leaf" | "contact";
}

const { lang, current } = Astro.props;
const isEn = lang === "en";
const prefix = isEn ? "/en" : "";
const logo = isEn ? "/assets/logo/neurinlab-logo-en.svg" : "/assets/logo/neurinlab-logo-ko.svg";
const nav = [
  { key: "home", label: "Home", href: `${prefix}/` },
  { key: "about", label: "About", href: `${prefix}/about/` },
  { key: "leaf", label: "Tools", href: `${prefix}/leaf/` },
  { key: "contact", label: "Contact Us", href: `${prefix}/contact/` }
];
const switchHref = isEn ? "/" : "/en/";
const switchLabel = isEn ? "KR" : "EN";
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand-logo" href={prefix || "/"} aria-label={isEn ? "Neurinlab home" : "느린랩 홈"}>
      <img src={logo} alt={isEn ? "Neurinlab" : "느린랩"} />
    </a>
    <div class="header-controls">
      <a class="mobile-language-link" href={switchHref} aria-label={isEn ? "한국어로 보기" : "View in English"}>
        {switchLabel}
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle>
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
        <span data-menu-label>Menu</span>
      </button>
    </div>
    <nav id="primary-nav" class="nav-wrap" aria-label={isEn ? "Primary navigation" : "주요 메뉴"} data-primary-nav>
      <ul class="nav-list">
        {nav.map((item) => (
          <li>
            <a class="nav-link" href={item.href} aria-current={current === item.key ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="language-link" href={switchHref}>{switchLabel}</a>
    </nav>
  </div>
</header>

<script is:inline>
  const header = document.querySelector(".site-header");
  const toggle = header?.querySelector("[data-menu-toggle]");
  const label = header?.querySelector("[data-menu-label]");
  const nav = header?.querySelector("[data-primary-nav]");

  const closeMenu = () => {
    nav?.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
    document.documentElement.classList.remove("menu-open");
    if (label) label.textContent = "Menu";
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    nav?.classList.toggle("is-open", !isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
    document.documentElement.classList.toggle("menu-open", !isOpen);
    if (label) label.textContent = isOpen ? "Menu" : "Close";
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("click", (event) => {
    if (header && !header.contains(event.target)) closeMenu();
  });
</script>
