---
interface Props {
  title: string;
  open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details class="policy-section" open={open}>
  <summary>
    <h2>{title}</h2>
    <span class="policy-toggle" aria-hidden="true"></span>
  </summary>
  <div class="policy-content">
    <slot />
  </div>
</details>
