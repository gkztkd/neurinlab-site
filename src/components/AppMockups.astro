---
interface Props {
  labels?: Array<{ title: string; sub: string }>;
  note?: string;
}

const {
  labels = [
    { title: "이미지 준비중", sub: "아이디어 목록 화면" },
    { title: "이미지 준비중", sub: "마인드맵 화면" }
  ],
  note = "앱 화면 이미지 준비중"
} = Astro.props;
---

<div class="app-visual" aria-label={note}>
  {labels.map((item) => (
    <div class="app-shot">
      <span class="app-shot-label">{item.title}</span>
      <span class="app-shot-sub">{item.sub}</span>
    </div>
  ))}
  <span class="asset-note">{note}</span>
</div>
