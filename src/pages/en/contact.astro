---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact Us | Neurinlab"
  description="Send a note about Neurinlab, content ideas, proposals, or collaboration."
  lang="en"
  current="contact"
>
  <section class="section hero narrow">
    <div class="section-inner">
      <h1 class="hero-title wide">Contact Us</h1>
      <p class="hero-copy compact">Send us a note about Neurinlab, content ideas, proposals, or collaboration.</p>
    </div>
  </section>

  <section class="split-section">
    <div class="section-inner">
      <div class="contact-panel">
        <p class="meta-label">Email</p>
        <a class="email-address" href="mailto:gkztkd@gmail.com">gkztkd@gmail.com</a>
        <p class="contact-note">Send Neurinlab inquiries to this email address.</p>
      </div>
    </div>
  </section>
</BaseLayout>
