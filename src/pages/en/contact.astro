---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact Us | Neurinlab"
  description="Get in touch with questions, proposals, or ideas for collaboration."
  lang="en"
  current="contact"
>
  <section class="section hero narrow">
    <div class="section-inner">
      <h1 class="hero-title wide">Contact Us</h1>
      <p class="hero-copy compact">Get in touch with questions, proposals, or ideas for collaboration.</p>
    </div>
  </section>

  <section class="split-section">
    <div class="section-inner">
      <div class="contact-panel">
        <p class="meta-label">Email</p>
        <a class="email-address" href="mailto:gzktkd@neurinlab.com">gzktkd@neurinlab.com</a>
        <p class="contact-note">Please contact Neurinlab at the email above.</p>
      </div>
    </div>
  </section>
</BaseLayout>
