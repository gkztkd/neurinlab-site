---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PolicySection from "../../../components/PolicySection.astro";
---

<BaseLayout
  title="Leaf Support | Neurinlab"
  description="Support information for Leaf login, sync, subscriptions, bug reports, and feature suggestions."
  lang="en"
  current="leaf"
>
  <section class="section hero">
    <div class="section-inner">
      <p class="eyebrow">Leaf Support</p>
      <h1 class="hero-title wide">How can we help?</h1>
      <p class="hero-copy compact">For questions about login, sync, subscriptions, bug reports, or feature suggestions.</p>
    </div>
  </section>

  <div class="policy-wrap">
    <PolicySection title="Email">
      <p>
        For support, contact <a href="mailto:gkztkd@gmail.com">gkztkd@gmail.com</a>.<br />
        Please include your device model, OS version, Leaf app version,
        and a brief description of the issue so we can look into it more accurately.
      </p>
    </PolicySection>
    <PolicySection title="Support Topics">
      <ul>
        <li>Account login and email verification</li>
        <li>Sync and backup issues</li>
        <li>Subscription and payment questions</li>
        <li>Bug reports</li>
        <li>Feature suggestions</li>
      </ul>
    </PolicySection>
  </div>
</BaseLayout>
