---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AppMockups from "../../../components/AppMockups.astro";
---

<BaseLayout
  title="Leaf | Neurinlab"
  description="Leaf is a lightweight thinking app for capturing ideas and turning them into projects, mind maps, notes, and tasks."
  lang="en"
  current="leaf"
>
  <section class="section hero leaf-hero">
    <div class="section-inner">
      <p class="eyebrow">Leaf</p>
      <h1 class="hero-title wide">Give passing thoughts a structure you can return to.</h1>
      <p class="hero-copy compact">
        Leaf helps you capture ideas quickly,<br />
        organize them by project,<br />
        and shape them into mind maps, notes, and tasks.
      </p>
      <img class="app-icon" src="/assets/app/leaf-icon.png" alt="Leaf app icon" />
    </div>
  </section>

  <section class="leaf-band leaf-detail-band">
    <div class="section-inner">
      <div class="feature-intro">
        <AppMockups
          labels={[
            { title: "Screenshot coming soon", sub: "Ideas" },
            { title: "Screenshot coming soon", sub: "Mind map" },
            { title: "Screenshot coming soon", sub: "Notes & tasks" }
          ]}
          note="Screenshots coming soon"
        />
        <div>
          <p class="meta-label">Core Features</p>
          <h2 class="feature-title">Catch ideas before they get scattered,<br />then expand them when you need more structure.</h2>
          <p class="feature-copy">
            An idea does not have to start as a finished sentence.
            Leaf gives scattered thoughts a place to grow into something usable.
          </p>
          <p class="flow-copy">Capture what comes up, connect what belongs together, and turn it into a next step.</p>
        </div>
      </div>

      <div class="card-grid">
        <article class="info-card">
          <h2>Projects</h2>
          <p>Create a project for each topic and keep related ideas in one place.</p>
        </article>
        <article class="info-card">
          <h2>Mind Maps</h2>
          <p>Branch out from a single idea and see how your thoughts connect.</p>
        </article>
        <article class="info-card">
          <h2>Notes & Tasks</h2>
          <p>Add notes and tasks to each node so ideas can move toward action.</p>
        </article>
      </div>

      <div class="meta-section">
        <div>
          <p class="meta-label">Platform</p>
          <p class="meta-copy">Preparing for launch on iOS and macOS<br />Android and Windows support planned for a future release</p>
        </div>
        <div>
          <p class="meta-label">App Pages</p>
          <div class="inline-links">
            <a href="/en/leaf/support/">Leaf Support</a>
            <a href="/en/leaf/privacy/">Privacy Policy</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
