---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout title="Leaf | Neurinlab" description="Leaf is a thinking app for capturing ideas and turning them into projects, mind maps, notes, and tasks." lang="en" current="leaf">
  <section class="editorial-hero leaf-page-hero"><div class="wide-inner"><p class="editorial-kicker">Leaf</p><h1 class="editorial-title"><span>Turn passing thoughts</span><span>into usable structure.</span></h1><p class="editorial-copy">Capture ideas quickly, organize them by project,<br />then shape them into mind maps, notes, and tasks.</p></div></section>
  <figure class="campaign-art leaf-campaign-art"><img src="/images/leaf/leaf-everywhere.png" alt="Leaf running across iPhone, iPad, and Mac" /></figure>
  <section class="leaf-statement"><div class="wide-inner split-editorial-grid"><p class="section-label">Core Features</p><div><h2>Catch ideas before they scatter,<br />then give them room to grow.</h2><p>An idea does not have to start as a finished sentence. Leaf gives scattered thoughts a place to grow into something useful.</p></div></div></section>
  <section class="dark-principle"><div class="wide-inner"><p class="section-label">How Leaf Works</p><h2>Capture what comes up, connect what belongs,<br />and turn it into a next step.</h2></div></section>
  <section class="features-section"><div class="wide-inner"><div class="feature-row"><span>01</span><h2>Projects</h2><p>Create a project for each topic and keep related ideas in one place.</p></div><div class="feature-row"><span>02</span><h2>Mind Maps</h2><p>Branch out from a single idea and see how your thoughts connect.</p></div><div class="feature-row"><span>03</span><h2>Notes & Tasks</h2><p>Add notes and tasks to each node so ideas can move toward action.</p></div></div></section>
  <section class="leaf-meta-section"><div class="wide-inner leaf-meta-grid"><div><p class="section-label">Platforms</p><p>Preparing for launch on iPhone, iPad, and Mac<br />Android and Windows support planned</p></div><div><p class="section-label">App Pages</p><a class="text-link" href="/en/leaf/support/">Leaf Support ↗</a><a class="text-link" href="/en/leaf/privacy/">Privacy Policy ↗</a></div></div></section>
</BaseLayout>
