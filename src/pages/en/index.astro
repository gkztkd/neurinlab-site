---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Neurinlab"
  description="Keeping our own way of thinking in the age of AI."
  lang="en"
  current="home"
>
  <section class="home-hero">
    <div class="section-inner home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow home-eyebrow">A slower practice for thinking and language in the age of AI</p>
        <h1 class="home-title home-title-en">
          <span>Keeping our own</span>
          <span>way of thinking</span>
          <span>in the age of AI.</span>
        </h1>
        <p class="home-copy">
          <span class="desktop-copy">
            We use fast tools, but keep looking for ways to think clearly,<br />
            write in our own words, and express ideas with more depth.
          </span>
          <span class="mobile-copy">
            We use fast tools, but keep looking for ways<br />
            to think clearly, write in our own words,<br />
            and express ideas with more depth.
          </span>
        </p>
        <div class="actions home-actions">
          <a class="button primary" href="/en/about/">About Neurinlab</a>
          <a class="button" href="/en/leaf/">Explore Leaf</a>
        </div>
        <p class="home-lower-note home-lower-note-desktop">Careful questions can become useful tools.</p>
      </div>

      <div class="home-image-placeholder" aria-label="Home image coming soon">
        <span class="placeholder-kicker">Visual</span>
        <strong>Coming soon</strong>
        <span>A mind map visual or app screen will be added here.</span>
      </div>
      <p class="home-lower-note home-lower-note-mobile">Careful questions can become useful tools.</p>
    </div>
  </section>

  <section class="home-problem">
    <div class="section-inner home-problem-grid">
      <h2 class="home-section-title">When fast results<br />make your thinking blur</h2>
      <p class="home-section-copy">
        AI helps us write, create, and organize faster.<br />
        But speed can make it harder<br class="mobile-only" />
        to hear what we actually think.<br />
        Neurinlab asks how we can use AI<br class="mobile-only" />
        without losing our own thoughts and words.
      </p>
    </div>
  </section>
</BaseLayout>
