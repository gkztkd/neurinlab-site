---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Neurinlab"
  description="So we don't lose our own thinking in the age of AI."
  lang="en"
  current="home"
>
  <section class="home-hero">
    <div class="section-inner home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow home-eyebrow">Slow experiments in thinking and language for the age of AI</p>
        <h1 class="home-title home-title-en">
          <span>So we don't lose</span>
          <span>our own thinking</span>
          <span>in the age of AI.</span>
        </h1>
        <p class="home-copy">
          <span class="desktop-copy">
            We use fast tools while looking for ways to think for ourselves,<br />
            write in our own words, and express ideas with greater depth.
          </span>
          <span class="mobile-copy">
            We use fast tools while looking for ways<br />
            to think for ourselves, write in our own words,<br />
            and express ideas with greater depth.
          </span>
        </p>
        <div class="actions home-actions">
          <a class="button primary" href="/en/about/">About Neurinlab</a>
          <a class="button" href="/en/leaf/">Explore Leaf</a>
        </div>
        <p class="home-lower-note home-lower-note-desktop">Slow questions become practical tools.</p>
      </div>

      <div class="home-image-placeholder" aria-label="Home image coming soon">
        <span class="placeholder-kicker">Image</span>
        <strong>Image coming soon</strong>
        <span>To be replaced with a mind map visual or app screen</span>
      </div>
      <p class="home-lower-note home-lower-note-mobile">Slow questions become practical tools.</p>
    </div>
  </section>

  <section class="home-problem">
    <div class="section-inner home-problem-grid">
      <h2 class="home-section-title">When your own thinking<br />starts to blur</h2>
      <p class="home-section-copy">
        AI helps us write, create, and organize faster.<br />
        But when results arrive quickly,<br class="mobile-only" />
        our own thinking can become less clear.<br />
        Neurinlab asks how to use AI<br class="mobile-only" />
        without losing our own thoughts and language.
      </p>
    </div>
  </section>
</BaseLayout>
