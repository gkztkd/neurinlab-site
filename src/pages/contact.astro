---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact Us | 느린랩"
  description="느린랩에 관한 제안이나 협업 문의를 보낼 수 있는 페이지입니다."
  current="contact"
>
  <section class="section hero narrow">
    <div class="section-inner">
      <h1 class="hero-title wide">Contact Us</h1>
      <p class="hero-copy compact">느린랩에 관한 제안이나 협업 문의는 이메일로 보내주세요.</p>
    </div>
  </section>

  <section class="split-section">
    <div class="section-inner">
      <div class="contact-panel">
        <p class="meta-label">문의 이메일</p>
        <a class="email-address" href="mailto:gzktkd@neurinlab.com">gzktkd@neurinlab.com</a>
        <p class="contact-note">확인 후 답변드리겠습니다.</p>
      </div>
    </div>
  </section>
</BaseLayout>
