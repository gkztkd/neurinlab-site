---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "ko" | "en";
  current?: "home" | "about" | "leaf" | "contact";
}

const {
  title,
  description,
  lang = "ko",
  current = "home"
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://www.neurinlab.com");
const pathname = Astro.url.pathname;
const koPath = lang === "en" ? pathname.replace(/^\/en(?=\/|$)/, "") || "/" : pathname;
const enPath = lang === "en" ? pathname : `/en${pathname}`;
const canonicalUrl = new URL(pathname, siteUrl);
const koUrl = new URL(koPath, siteUrl);
const enUrl = new URL(enPath, siteUrl);
const shareImagePath = lang === "ko"
  ? "/images/share-neurinlab-ko.png"
  : "/images/share-neurinlab-en.png";
const shareImageUrl = new URL(shareImagePath, siteUrl);
const shareImageAlt = lang === "ko"
  ? "느린랩 공유 이미지"
  : "Neurinlab social preview";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ko" href={koUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={koUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={lang === "ko" ? "느린랩" : "Neurinlab"} />
    <meta property="og:locale" content={lang === "ko" ? "ko_KR" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "ko" ? "en_US" : "ko_KR"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <link rel="icon" href="/favicon.svg?v=39" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png?v=39" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=39" sizes="180x180" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <Header lang={lang} current={current} />
      <main class="site-main">
        <slot />
      </main>
      <Footer lang={lang} current={current} />
    </div>
  </body>
</html>
